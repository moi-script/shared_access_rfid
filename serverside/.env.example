# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Number of reverse proxies in front of this process. 0 locally; 1 behind
# Render/Railway/nginx. Left at 0 on a proxied host, every request appears to
# come from the proxy and the rate limiters throttle all users as one bucket.
TRUST_PROXY=0

# The server buckets attendance dates, the occupancy reset and vehicle-pass
# expiry in LOCAL time. Cloud hosts default to UTC — set this in deployment.
# TZ=Asia/Manila

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/ncst_rfid?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change_me_to_random_256bit_string
JWT_REFRESH_SECRET=change_me_to_different_random_256bit_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed (used once)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=StrongAdminPass@2025!

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
# Two black-box harnesses now log in repeatedly: npm run verify:roles and
# npm run verify:gates. A dev session commonly runs both, and each harness's
# own re-runnability proof (Task 14 for verify:roles) means running the same
# one twice in a row within one window. 50 gives that room in development;
# a much smaller number (e.g. 10) is appropriate in production.
LOGIN_RATE_LIMIT_MAX=50
SCAN_RATE_LIMIT_MAX=60

# Opt-out for the verify:* harnesses, which issue far more requests per
# minute than any human client and would otherwise trip the limits above when
# run back to back. shouldBypassRateLimit() (src/middlewares/rateLimiter.ts)
# only honours this when NODE_ENV is not production, so leaving it commented
# out (the default) or set is equally safe in production — but never set it
# on a production host regardless.
# VERIFY_BYPASS_TOKEN=some-local-only-random-string

# Cookie
COOKIE_SECRET=change_me_to_random_string

# Refresh-cookie SameSite policy. 'strict' is correct when the client is served
# from the same site as the API (the local setup). When the client is on a
# different site — the production split of Vercel frontend + Render API — the
# browser drops a strict/lax cookie on every cross-site call and POST
# /auth/refresh starts failing with "No refresh token". Use:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
# together; the server refuses to start on none without secure, because
# browsers discard that combination anyway.
COOKIE_SAMESITE=strict
# COOKIE_SECURE defaults to on under NODE_ENV=production. Set it explicitly
# only to override that.
# COOKIE_SECURE=true

# Attendance
LATE_CUTOFF_TIME=08:00

# Occupancy (anti-passback). HH:MM, interpreted in the SERVER's LOCAL time
# (not UTC) — see "Attendance date bucketing" in README.md. A UTC host left at
# the default lands the boundary at 07:00 Manila, inside the morning arrival
# rush. Set TZ=Asia/Manila in deployment, or explicitly accept that window.
OCCUPANCY_RESET_TIME=23:00

# Vehicle pass expiry. MM-DD, interpreted in the SERVER's LOCAL time (not
# UTC) — see "Attendance date bucketing" in README.md. A malformed value
# stops the server at startup instead of silently becoming an Invalid Date.
SCHOOL_YEAR_END_MMDD=03-31

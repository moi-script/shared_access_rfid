# Production environment for the Next.js client.
#
# On Vercel these go in Project → Settings → Environment Variables (Production),
# NOT in a file — .gitignore excludes every .env*, and Vercel needs the value at
# BUILD time regardless, because NEXT_PUBLIC_* is inlined into the bundle.
#
# Changing this variable requires a REDEPLOY. Editing it in the Vercel dashboard
# alone does nothing to the already-built bundle.

# Base URL of the deployed Express API, including the /api prefix and no
# trailing slash. Must be https — the browser blocks plain-http calls from an
# https page, and the refresh cookie is Secure.
NEXT_PUBLIC_API_BASE_URL=https://ncst-rfid-api.onrender.com/api
